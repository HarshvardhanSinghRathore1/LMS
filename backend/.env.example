# ==========================================
# CAPACITY CONNECT — ENVIRONMENT CONFIGURATION
# ==========================================

# SERVER & DATABASE
PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/capacity_connect
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# STAGE 1 — AUTHENTICATION & SECURITY
# Strong random secrets required (do not use weak defaults in production)
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_ROUNDS=12

# ADMIN BOOTSTRAP SEEDING
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_ORGANIZATION_CODE=

# AI & RAG INFRASTRUCTURE
AI_PROVIDER=huggingface

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

HF_API_KEY=
HF_MODEL=BAAI/bge-small-en-v1.5

EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

PGVECTOR_ENABLED=true

GRAPHITI_ENABLED=false
GRAPHITI_URL=http://localhost:8000
GRAPHITI_API_KEY=
